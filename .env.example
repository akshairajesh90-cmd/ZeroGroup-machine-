# ============================================================
# ZERO GROUP — ZERO GROUP
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# DATABASE
# Cloud PostgreSQL connection string (Neon, Supabase, Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ZeroGroup?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/ZeroGroup?sslmode=require"
# NOTE: DIRECT_URL is required by Supabase/PgBouncer for Prisma migrations.
# For Neon, DIRECT_URL and DATABASE_URL can be the same.

# ------------------------------------------------------------
# NEXTAUTH v5
# Generate AUTH_SECRET with: npx auth secret
# ------------------------------------------------------------
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET_32_CHARS_MIN"
AUTH_URL="http://localhost:3000"
# In production, set AUTH_URL to your deployed domain, e.g.:
# AUTH_URL="https://ZeroGroup.yourdomain.com"

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# FIREBASE PHONE AUTH (10,000 free carrier SMS/month)
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="zerogroup-c4814.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="zerogroup-c4814"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="zerogroup-c4814.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="715187092393"
NEXT_PUBLIC_FIREBASE_APP_ID="1:715187092393:web:..."
