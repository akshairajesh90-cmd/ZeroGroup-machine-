generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  hashedPassword      String
  displayPassword     String?
  resetOtp            String?
  resetOtpExpires     DateTime?
  resetRequested      Boolean   @default(false)
  resetRequestedAt    DateTime?
  resetRequestNotes   String?
  role                Role      @default(DRIVER)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessionTokenVersion Int       @default(1)
  employee            Employee?

  @@index([email])
  @@index([resetRequested])
  @@index([isActive])
  @@map("users")
}

model Customer {
  id                String           @id @default(cuid())
  name              String
  address           String
  phone             String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isPendingDelete   Boolean          @default(false)
  markedForDeleteBy String?
  dispatches        DailyDispatch[]
  invoices          Invoice[]
  PaymentReceipt    PaymentReceipt[]

  @@index([name])
  @@map("customers")
}

model Invoice {
  id                String           @id @default(cuid())
  invoiceNumber     String           @unique
  customerId        String
  totalAmount       Decimal          @db.Decimal(12, 2)
  advanceDeducted   Decimal          @default(0) @db.Decimal(10, 2)
  paidCash          Decimal          @default(0) @db.Decimal(10, 2)
  paidUpi           Decimal          @default(0) @db.Decimal(10, 2)
  paidBank          Decimal          @default(0) @db.Decimal(10, 2)
  paidCheque        Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal          @default(0) @db.Decimal(10, 2)
  paymentMethod     PaymentMethod?
  paidAt            DateTime?
  notes             String?
  siteLocation      String?
  status            InvoiceStatus    @default(DRAFT)
  issuedDate        DateTime         @db.Date
  dueDate           DateTime         @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isPendingDelete   Boolean          @default(false)
  markedForDeleteBy String?
  dispatches        DailyDispatch[]
  items             InvoiceItem[]    @relation("InvoiceLineItems")
  customer          Customer         @relation(fields: [customerId], references: [id])
  payments          PaymentReceipt[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  itemKey       String
  malayalamName String?
  description   String
  quantity      Int     @default(1)
  rate          Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  invoice       Invoice @relation("InvoiceLineItems", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Machine {
  id                       String              @id @default(cuid())
  machineId                String              @unique
  type                     MachineType
  status                   MachineStatus       @default(AVAILABLE)
  isActive                 Boolean             @default(true)
  operatorDailyPayout      Decimal             @db.Decimal(10, 2)
  fuelConsumptionThreshold Decimal             @default(2000) @db.Decimal(10, 2)
  notes                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  isPendingDelete          Boolean             @default(false)
  markedForDeleteBy        String?
  liftDispatches           DailyDispatch[]     @relation("SecondaryLift")
  dispatches               DailyDispatch[]     @relation("PrimaryMachine")
  vibratorDispatches       DailyDispatch[]     @relation("SecondaryVibrator")
  dispatchAssets           DispatchAsset[]
  dispatchMachines         DispatchMachine[]
  expenses                 Expense[]
  fuelLogs                 FuelLog[]
  maintenanceTickets       MaintenanceTicket[]

  @@index([status])
  @@index([isActive])
  @@map("machines")
}

model Tool {
  id                String         @id @default(cuid())
  toolId            String         @unique
  name              String
  toolType          String?
  totalInventory    Int            @default(10)
  status            ToolStatus     @default(AVAILABLE)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isPendingDelete   Boolean        @default(false)
  markedForDeleteBy String?
  dispatchTools     DispatchTool[]
  expenses          Expense[]

  @@index([status])
  @@index([isActive])
  @@map("tools")
}

model Employee {
  id                         String                  @id @default(cuid())
  name                       String
  role                       Role
  fixedSalary                Decimal?                @db.Decimal(10, 2)
  userId                     String                  @unique
  isActive                   Boolean                 @default(true)
  lastSeenAt                 DateTime?
  lastLatitude               Decimal?                @db.Decimal(10, 7)
  lastLongitude              Decimal?                @db.Decimal(10, 7)
  lastLocationUpdate         DateTime?
  lastSyncStatus             String?                 @default("ONLINE")
  offlineQueueCount          Int                     @default(0)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  isOwner_ExcludeFromPayroll Boolean                 @default(false)
  isPendingDelete            Boolean                 @default(false)
  markedForDeleteBy          String?
  baseDailyWage              Decimal?                @db.Decimal(10, 2)
  dailyBataRate              Decimal?                @db.Decimal(10, 2)
  hourlyRate                 Decimal?                @db.Decimal(10, 2)
  phone                      String?                 @unique
  address                    String?
  officialIdType             String?
  officialIdNumber           String?
  drivingLicenseNumber       String?
  employeeCode               String?
  isIdVerified               Boolean                 @default(false)
  idVerifiedAt               DateTime?
  idVerifiedBy               String?
  idVerifiedRole             String?
  gpayNumber                 String?
  upiId                      String?
  isCrewLeader               Boolean                 @default(false)
  operatorType               OperatorType            @default(INTERNAL)
  profilePhotoUrl            String?
  defaultCrewRole            CrewRole?
  capableRoles               CrewRole[] // Explicitly tagged roles they can perform
  paymentRecords             PaymentRecord[]
  auditLogs                  AuditLog[]              @relation("EmployeeAuditLogs")
  confirmedDeposits          CashCollection[]        @relation("DepositConfirmer")
  cashCollections            CashCollection[]
  chatMessages               ChatMessage[]
  driverDispatches           DailyDispatch[]         @relation("DriverDispatches")
  mainHelperDispatches       DailyDispatch[]         @relation("MainHelperDispatches")
  operatorDispatches         DailyDispatch[]         @relation("OperatorDispatches")
  workerDispatches           DailyDispatch[]         @relation("WorkerDispatches")
  dispatchLaborCrews         DispatchLabor[]
  dispatchAssignments        DispatchAssignment[]
  changedDispatchStatuses    DispatchStatusHistory[] @relation("StatusChanger")
  documents                  EmployeeDocument[]
  user                       User                    @relation(fields: [userId], references: [id])
  loggedExpenses             Expense[]               @relation("ExpenseLogger")
  advanceExpenses            Expense[]               @relation("ExpenseEmployee")
  fuelLogs                   FuelLog[]
  approvedAdjustments        ManualAdjustment[]      @relation("AdjustmentApprover")
  createdAdjustments         ManualAdjustment[]      @relation("AdjustmentCreator")
  manualAdjustments          ManualAdjustment[]      @relation("AdjustmentRecipient")
  paymentReceipts            PaymentReceipt[]        @relation("ReceiptCollector")
  settlements                Settlement[]            @relation("EmployeeSettlements")
  shiftLogs                  ShiftLog[]
  siteLaborDisbursements     SiteLaborDisbursement[]
  // IronRent field relations
  siteLeaderDispatches       DailyDispatch[]         @relation("SiteLeaderDispatches")
  locationPings              LocationPing[]
  fieldDiaryLogs             FieldDiaryLog[]         @relation("LoggedByLeader")
  staffDiaryOverrides        FieldDiaryLog[]         @relation("StaffDiaryOverrides")
  attendanceLogs             AttendanceLog[]
  uploadedPhotos             DispatchPhoto[]
  salaryAdvances             SalaryAdvance[]
  roleRates                  EmployeeRoleRate[]

  @@index([role])
  @@index([isActive])
  @@map("employees")
}

// Per-employee per-job wage rate card
// e.g. Ramesh earns â‚¹700 as Helper but â‚¹1100 as Mixer Operator
model EmployeeRoleRate {
  id         String   @id @default(cuid())
  employeeId String
  crewRole   CrewRole
  wagePerDay Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, crewRole])
  @@map("employee_role_rates")
}

model Vehicle {
  id                 String              @id @default(cuid())
  licensePlate       String              @unique
  type               String
  status             VehicleStatus       @default(AVAILABLE)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isPendingDelete    Boolean             @default(false)
  markedForDeleteBy  String?
  expenses           Expense[]
  fuelLogs           FuelLog[]
  maintenanceTickets MaintenanceTicket[]
  shiftLogs          ShiftLog[]
  documents          VehicleDocument[]
  dispatches         DailyDispatch[]

  @@index([status])
  @@index([isActive])
  @@map("vehicles")
}

model WorkTypeRate {
  id             String      @id @default(cuid())
  machineType    MachineType
  workType       WorkType
  payoutRate     Decimal     @db.Decimal(10, 2)
  customerCharge Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([machineType, workType])
  @@map("work_type_rates")
}

model DailyDispatch {
  id                    String                  @id @default(cuid())
  customerId            String
  machineId             String?
  liftId                String?
  vibratorId            String?
  vehicleId             String?
  routeStopOrder        Int?                    @default(1)
  driverId              String?
  operatorId            String?
  workerId              String?
  mainHelperId          String?
  location              String
  mapLink               String?
  latitude              Decimal?                @db.Decimal(10, 7)
  longitude             Decimal?                @db.Decimal(10, 7)
  dateOfService         DateTime                @db.Date
  workType              WorkType                @default(NORMAL)
  status                DispatchStatus          @default(PENDING)
  operatorDailyRate     Decimal?                @db.Decimal(10, 2)
  customerCharge        Decimal?                @db.Decimal(10, 2)
  notes                 String?
  liftFloors            Int?                    @default(1)
  mixerCategory         MixerCategory?          @default(STANDARD)
  vibratorType          VibratorType?
  hasTrollyBench        Boolean                 @default(false)
  cementBags            Int?                    @default(0)
  mainHelperName        String?
  helperCount           Int                     @default(0)
  trollyWorkerCount     Int                     @default(0)
  customOperatorWage    Decimal?                @db.Decimal(10, 2)
  actualWagePaid        Decimal?                @default(0) @db.Decimal(10, 2)
  machineNumberTag      String?
  publicTransportUsed   Boolean                 @default(false)
  siteBundleId          String?
  isScopeFinalized      Boolean                 @default(false)
  closingWorkNotes      String?
  invoiceId             String?
  version               Int                     @default(1)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  projectId             String?
  siteLeaderEmployeeId  String?
  project               Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conflictReport        String?
  isFlagged             Boolean                 @default(false)
  isPendingDelete       Boolean                 @default(false)
  markedForDeleteBy     String?
  cashCollected         Decimal                 @default(0) @db.Decimal(10, 2)
  paymentStatus         String                  @default("PENDING")
  jobGroupId            String?
  externalSubLeaderName String?
  arrivedOperatorIds    String[]
  deliveredAt           DateTime?
  deliveredByDriverId   String?
  deliveredToolIds      String[]
  returnedToolIds       String[]
  isPrimaryBillingRow   Boolean                 @default(false)
  toolRent              Decimal?                @default(0) @db.Decimal(10, 2)
  paymentRecords        PaymentRecord[]
  cashCollections       CashCollection[]
  customer              Customer                @relation(fields: [customerId], references: [id])
  vehicle               Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver                Employee?               @relation("DriverDispatches", fields: [driverId], references: [id], onDelete: Restrict)
  invoice               Invoice?                @relation(fields: [invoiceId], references: [id])
  lift                  Machine?                @relation("SecondaryLift", fields: [liftId], references: [id], onDelete: Restrict)
  machine               Machine?                @relation("PrimaryMachine", fields: [machineId], references: [id], onDelete: Restrict)
  mainHelper            Employee?               @relation("MainHelperDispatches", fields: [mainHelperId], references: [id])
  operator              Employee?               @relation("OperatorDispatches", fields: [operatorId], references: [id], onDelete: Restrict)
  vibrator              Machine?                @relation("SecondaryVibrator", fields: [vibratorId], references: [id], onDelete: Restrict)
  worker                Employee?               @relation("WorkerDispatches", fields: [workerId], references: [id], onDelete: Restrict)
  dispatchAssets        DispatchAsset[]
  dispatchLabor         DispatchLabor[]
  dispatchMachines      DispatchMachine[]
  crewAssignments       DispatchAssignment[]
  siteDisbursements     SiteLaborDisbursement[]
  statusHistory         DispatchStatusHistory[]
  dispatchTools         DispatchTool[]
  siteLeader            Employee?               @relation("SiteLeaderDispatches", fields: [siteLeaderEmployeeId], references: [id], onDelete: SetNull)
  locationPings         LocationPing[]
  fieldDiaryLogs        FieldDiaryLog[]
  dispatchPhotos        DispatchPhoto[]
  expenses              Expense[]

  @@unique([dateOfService, customerId, siteBundleId])
  @@index([status])
  @@index([operatorId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([dateOfService])
  @@index([invoiceId])
  @@index([siteBundleId])
  @@index([siteLeaderEmployeeId])
  @@map("daily_dispatches")
}

model DispatchMachine {
  id         String        @id @default(cuid())
  dispatchId String
  machineId  String
  dispatch   DailyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  machine    Machine       @relation(fields: [machineId], references: [id])

  @@unique([dispatchId, machineId])
  @@map("dispatch_machines")
}

model DispatchAsset {
  id         String        @id @default(cuid())
  dispatchId String
  machineId  String
  dispatch   DailyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  machine    Machine       @relation(fields: [machineId], references: [id])

  @@unique([dispatchId, machineId])
  @@map("dispatch_assets")
}

model DispatchTool {
  id                     String                     @id @default(cuid())
  dispatchId             String
  toolId                 String
  quantity               Int                        @default(1)
  variant                String?
  returnStatus           ToolReturnStatus           @default(PENDING)
  returnNote             String?
  returnedAt             DateTime?
  dispatch               DailyDispatch              @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  tool                   Tool                       @relation(fields: [toolId], references: [id])
  equipmentVerifications EquipmentVerificationLog[]

  @@unique([dispatchId, toolId, variant])
  @@map("dispatch_tools")
}

model DispatchLabor {
  id                  String        @id @default(cuid())
  dispatchId          String
  internalEmployeeId  String?
  externalWorkerName  String?
  headCount           Int           @default(1)
  helperCount         Int           @default(0)
  lumpSumWage         Decimal       @default(0) @db.Decimal(10, 2)
  actualWagePaid      Decimal?      @default(0) @db.Decimal(10, 2)
  internalHeadCount   Int           @default(0)
  externalHeadCount   Int           @default(0)
  outsideWagePaid     Decimal       @default(0) @db.Decimal(10, 2)
  isExternalLiability Boolean       @default(false)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  dispatch            DailyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  employee            Employee?     @relation(fields: [internalEmployeeId], references: [id])

  @@map("dispatch_labor_crews")
}

model DispatchAssignment {
  id             String   @id @default(cuid())
  dispatchId     String
  employeeId     String?
  contractorId   String?
  assignedRole   CrewRole
  lockedWageRate Decimal  @db.Decimal(10, 2)
  headcount      Int      @default(1)
  settlementId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dispatch   DailyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  employee   Employee?     @relation(fields: [employeeId], references: [id])
  contractor Contractor?   @relation(fields: [contractorId], references: [id])
  settlement Settlement?   @relation(fields: [settlementId], references: [id])

  @@unique([dispatchId, employeeId])
  @@unique([dispatchId, contractorId])
  @@map("dispatch_assignments")
}

model DispatchStatusHistory {
  id          String         @id @default(cuid())
  dispatchId  String
  oldStatus   DispatchStatus
  newStatus   DispatchStatus
  changedById String
  reason      String
  createdAt   DateTime       @default(now())
  changedBy   Employee       @relation("StatusChanger", fields: [changedById], references: [id])
  dispatch    DailyDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@index([changedById])
  @@map("dispatch_status_history")
}

model ShiftLog {
  id                String    @id @default(cuid())
  driverId          String
  vehicleId         String
  date              DateTime  @db.Date
  startTime         DateTime
  endTime           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isPendingDelete   Boolean   @default(false)
  markedForDeleteBy String?
  driver            Employee  @relation(fields: [driverId], references: [id])
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([driverId])
  @@index([date])
  @@map("shift_logs")
}

model Expense {
  id                String          @id @default(cuid())
  loggerId          String
  amount            Decimal         @db.Decimal(10, 2)
  category          ExpenseCategory
  description       String?
  date              DateTime        @db.Date
  vehicleId         String?
  machineId         String?
  dispatchId        String?
  employeeId        String?
  contractorId      String?
  toolId            String?
  settlementId      String?
  notes             String?
  isAlertTriggered  Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isPendingDelete   Boolean         @default(false)
  markedForDeleteBy String?
  logger            Employee        @relation("ExpenseLogger", fields: [loggerId], references: [id])
  machine           Machine?        @relation(fields: [machineId], references: [id], onDelete: Restrict)
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  dispatch          DailyDispatch?  @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  employee          Employee?       @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  contractor        Contractor?     @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  tool              Tool?           @relation(fields: [toolId], references: [id], onDelete: SetNull)
  settlement        Settlement?     @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([loggerId])
  @@index([date])
  @@index([vehicleId])
  @@index([machineId])
  @@index([settlementId])
  @@map("expenses")
}

model CashCollection {
  id                String            @id @default(cuid())
  operatorId        String
  dispatchId        String
  amountCollected   Decimal           @db.Decimal(10, 2)
  date              DateTime          @db.Date
  status            CashDepositStatus @default(PENDING_DEPOSIT)
  confirmedById     String?
  confirmedAt       DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isPendingDelete   Boolean           @default(false)
  markedForDeleteBy String?
  confirmedBy       Employee?         @relation("DepositConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  dispatch          DailyDispatch     @relation(fields: [dispatchId], references: [id])
  operator          Employee          @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@index([status])
  @@index([date])
  @@map("cash_collections")
}

model ManualAdjustment {
  id                String                 @id @default(cuid())
  employeeId        String
  amount            Decimal                @db.Decimal(10, 2)
  type              AdjustmentType
  reason            String
  date              DateTime               @db.Date
  settlementStatus  AdjustmentStatus       @default(PENDING)
  status            ManualAdjustmentStatus @default(PENDING)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  approvalStatus    String                 @default("APPROVED")
  isPendingDelete   Boolean                @default(false)
  markedForDeleteBy String?
  approvedBy        Employee?              @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy         Employee               @relation("AdjustmentCreator", fields: [createdById], references: [id])
  employee          Employee               @relation("AdjustmentRecipient", fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([createdById])
  @@index([approvedById])
  @@index([settlementStatus])
  @@index([status])
  @@map("manual_adjustments")
}

model Settlement {
  id           String           @id @default(cuid())
  employeeId   String?
  contractorId String?
  weekEnding   DateTime         @db.Date
  finalPayout  Decimal          @db.Decimal(12, 2)
  amountPaid   Decimal          @default(0) @db.Decimal(12, 2)
  notes        String?
  status       SettlementStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee            Employee?            @relation("EmployeeSettlements", fields: [employeeId], references: [id])
  contractor          Contractor?          @relation("ContractorSettlements", fields: [contractorId], references: [id])
  dispatchAssignments DispatchAssignment[]
  expenses            Expense[]

  @@index([employeeId])
  @@index([contractorId])
  @@index([weekEnding])
  @@index([status])
  @@map("settlements")
}

model Contractor {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dispatchAssignments DispatchAssignment[]
  expenses            Expense[]
  settlements         Settlement[]         @relation("ContractorSettlements")

  @@map("contractors")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actionType String
  actorRole  Role
  modelName  String?
  newPayload Json?
  oldPayload Json?
  timestamp  DateTime @default(now())
  entity     String?
  actor      Employee @relation("EmployeeAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([actionType])
  @@index([timestamp])
  @@map("audit_logs")
}

model VehicleDocument {
  id                String         @id @default(cuid())
  vehicleId         String
  type              DocumentType
  documentNumber    String
  issueDate         DateTime       @db.Date
  expiryDate        DateTime       @db.Date
  attachmentUrl     String
  status            DocumentStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isPendingDelete   Boolean        @default(false)
  markedForDeleteBy String?
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([type])
  @@map("vehicle_documents")
}

model EmployeeDocument {
  id                String         @id @default(cuid())
  employeeId        String
  type              DocumentType
  documentNumber    String
  issueDate         DateTime       @db.Date
  expiryDate        DateTime       @db.Date
  attachmentUrl     String
  status            DocumentStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isPendingDelete   Boolean        @default(false)
  markedForDeleteBy String?
  employee          Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@map("employee_documents")
}

model MaintenanceTicket {
  id                String            @id @default(cuid())
  machineId         String?
  vehicleId         String?
  issueDescription  String
  mechanicName      String?
  partsCost         Decimal           @default(0) @db.Decimal(12, 2)
  laborCost         Decimal           @default(0) @db.Decimal(12, 2)
  status            MaintenanceStatus @default(OPEN)
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isPendingDelete   Boolean           @default(false)
  markedForDeleteBy String?
  machine           Machine?          @relation(fields: [machineId], references: [id], onDelete: Restrict)
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([machineId])
  @@index([vehicleId])
  @@map("maintenance_tickets")
}

model FuelLog {
  id                String   @id @default(cuid())
  machineId         String?
  vehicleId         String?
  driverId          String
  liters            Decimal  @db.Decimal(8, 2)
  totalCost         Decimal  @db.Decimal(12, 2)
  odometerReading   Int?
  receiptUrl        String
  date              DateTime @db.Date
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  approvalStatus    String   @default("APPROVED")
  isPendingDelete   Boolean  @default(false)
  markedForDeleteBy String?
  driver            Employee @relation(fields: [driverId], references: [id])
  machine           Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([machineId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("fuel_logs")
}

model PaymentReceipt {
  id                    String        @id @default(cuid())
  receiptNumber         String        @unique
  customerId            String
  invoiceId             String?
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  paymentDate           DateTime      @db.Date
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  depositStatus         String?       @default("PENDING_DEPOSIT")
  collectedByEmployeeId String?
  dispatchId            String?
  isPendingDelete       Boolean       @default(false)
  markedForDeleteBy     String?
  collector             Employee?     @relation("ReceiptCollector", fields: [collectedByEmployeeId], references: [id], onDelete: Restrict)
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([depositStatus])
  @@map("payment_receipts")
}

model PaymentRecord {
  id              String        @id @default(cuid())
  dispatchId      String
  amount          Decimal       @db.Decimal(10, 2)
  method          String
  collectedById   String
  verifiedByStaff Boolean       @default(false)
  createdAt       DateTime      @default(now())
  collectedBy     Employee      @relation(fields: [collectedById], references: [id])
  dispatch        DailyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([collectedById])
  @@index([dispatchId])
}

model ChatMessage {
  id                String   @id @default(cuid())
  text              String?
  mediaUrl          String?
  mediaType         String?
  senderId          String
  createdAt         DateTime @default(now())
  isPendingDelete   Boolean  @default(false)
  markedForDeleteBy String?
  sender            Employee @relation(fields: [senderId], references: [id])

  @@index([createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model SystemSettings {
  id              String   @id @default(cuid())
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

