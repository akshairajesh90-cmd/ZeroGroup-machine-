model Project {
  id         String          @id @default(cuid())
  name       String
  location   String
  status     String          @default("ACTIVE")
  startDate  DateTime        @db.Date
  endDate    DateTime?       @db.Date
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  dispatches DailyDispatch[]

  @@map("projects")
}

model ExternalSubLeader {
  id    String @id @default(cuid())
  name  String
  phone String
  defaultWorkerRate Decimal? @db.Decimal(10, 2)

  disbursements SiteLaborDisbursement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("external_sub_leaders")
}

model SiteLaborDisbursement {
  id                  String   @id @default(cuid())
  dispatchId          String
  internalOperatorId  String
  subLeaderId         String
  date                DateTime @db.Date
  totalCashHandedOut  Decimal  @db.Decimal(10, 2)
  externalWorkerNames String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatch         DailyDispatch     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  internalOperator Employee          @relation(fields: [internalOperatorId], references: [id], onDelete: Restrict)
  subLeader        ExternalSubLeader @relation(fields: [subLeaderId], references: [id], onDelete: Restrict)

  @@map("site_labor_disbursements")
}

