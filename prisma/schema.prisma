model LocationPing {
  id         String   @id @default(cuid())
  employeeId String
  dispatchId String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Float?
  altitude   Float?
  speed      Float?
  timestamp  DateTime @default(now())
  source     String   @default("CAPACITOR") // CAPACITOR | BROWSER

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dispatch DailyDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([dispatchId])
  @@index([timestamp])
  @@map("location_pings")
}

model FieldDiaryLog {
  id                  String    @id @default(cuid())
  dispatchId          String
  loggedByLeaderId    String?
  date                DateTime  @db.Date
  siteStatus          String    @default("IN_PROGRESS")
  arrivalTime         DateTime?
  departureTime       DateTime?
  internalHelperCount Int       @default(0)
  notes               String?
  isSubmitted         Boolean   @default(false)
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Staff Override Metadata
  isStaffOverridden Boolean   @default(false)
  overriddenById    String?
  overriddenAt      DateTime?

  dispatch               DailyDispatch              @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  loggedByLeader         Employee?                  @relation("LoggedByLeader", fields: [loggedByLeaderId], references: [id])
  overriddenBy           Employee?                  @relation("StaffDiaryOverrides", fields: [overriddenById], references: [id])
  attendanceLogs         AttendanceLog[]
  externalLabor          ExternalLaborLog[]
  equipmentVerifications EquipmentVerificationLog[]
  photos                 DispatchPhoto[]

  @@unique([dispatchId, date])
  @@index([dispatchId])
  @@index([loggedByLeaderId])
  @@map("field_diary_logs")
}

model AttendanceLog {
  id              String   @id @default(cuid())
  fieldDiaryLogId String
  employeeId      String
  isPresent       Boolean  @default(true)
  markedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  fieldDiaryLog FieldDiaryLog @relation(fields: [fieldDiaryLogId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id])

  @@unique([fieldDiaryLogId, employeeId])
  @@index([fieldDiaryLogId])
  @@map("attendance_logs")
}

model ExternalLaborLog {
  id              String   @id @default(cuid())
  fieldDiaryLogId String
  subLeaderName   String
  workerCount     Int
  cashPaid        Decimal  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())

  fieldDiaryLog FieldDiaryLog @relation(fields: [fieldDiaryLogId], references: [id], onDelete: Cascade)

  @@index([fieldDiaryLogId])
  @@map("external_labor_logs")
}

model EquipmentVerificationLog {
  id              String   @id @default(cuid())
  fieldDiaryLogId String
  dispatchToolId  String
  isReturned      Boolean  @default(true)
  condition       String   @default("OK") // "OK" | "DAMAGED" | "MISSING"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fieldDiaryLog FieldDiaryLog @relation(fields: [fieldDiaryLogId], references: [id], onDelete: Cascade)
  dispatchTool  DispatchTool  @relation(fields: [dispatchToolId], references: [id], onDelete: Cascade)

  @@unique([fieldDiaryLogId, dispatchToolId])
  @@index([fieldDiaryLogId])
  @@map("equipment_verification_logs")
}

model DispatchPhoto {
  id              String   @id @default(cuid())
  dispatchId      String
  fieldDiaryLogId String?
  uploadedById    String
  photoUrl        String
  caption         String?
  uploadedAt      DateTime @default(now())

  dispatch      DailyDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fieldDiaryLog FieldDiaryLog? @relation(fields: [fieldDiaryLogId], references: [id], onDelete: SetNull)
  uploadedBy    Employee       @relation(fields: [uploadedById], references: [id])

  @@index([dispatchId])
  @@index([fieldDiaryLogId])
  @@map("dispatch_photos")
}

model SalaryAdvance {
  id           String     @id @default(cuid())
  employeeId   String
  amount       Decimal    @db.Decimal(10, 2)
  date         DateTime   @db.Date
  notes        String?
  status       String     @default("PENDING") // PENDING, SETTLED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee     Employee   @relation(fields: [employeeId], references: [id])
}

