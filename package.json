    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^18",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18",
