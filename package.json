{
  "name": "zero-group",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "npx tsx prisma/seed-28day-tight-schedule.ts",
    "db:seed:notebook": "npx tsx prisma/seed-notebook-data.ts",
    "test": "jest --testPathPatterns=testing/ --forceExit",
    "test:unit": "jest --testPathPatterns=testing/1_unit --forceExit --verbose",
    "test:integration": "jest --testPathPatterns=testing/2_integration --forceExit --verbose",
    "test:regression": "jest --testPathPatterns=testing/5_regression --forceExit --verbose",
    "test:performance": "jest --testPathPatterns=testing/6_performance --forceExit --verbose --testTimeout=60000",
    "test:security": "jest --testPathPatterns=testing/7_security --forceExit --verbose",
    "test:jest-all": "jest --testPathPatterns=testing/ --forceExit --verbose",
    "test:system": "npx playwright test testing/3_system/system.spec.ts --project=chromium",
    "test:acceptance": "npx playwright test testing/4_acceptance/acceptance.spec.ts --project=chromium",
    "test:simulation": "npx playwright test testing/full_simulation/full_simulation.spec.ts --project=chromium --reporter=list",
    "test:simulation:headed": "npx playwright test testing/full_simulation/full_simulation.spec.ts --project=chromium --headed --reporter=list"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed-28day-tight-schedule.ts"
  },
  "dependencies": {
